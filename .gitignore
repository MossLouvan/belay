# dependencies
node_modules/

# builds / artifacts
dist/
build/
web-build/
.expo/
.expo-shared/
server/native/BelayHost.exe
server/native/BelayHostMac
# pre-rename helper binaries, still runnable until the next build:native
server/native/TetherHost.exe
server/native/TetherHostMac
server/dist/

# runtime state (contains device tokens)
belay-state.json
server/belay-state.json
# pre-rename state, kept on disk after migration — same tokens inside
tether-state.json
server/tether-state.json

# test output
test-results/
playwright-report/
blob-report/
screenshots/
.tmp/

# logs
*.log
npm-debug.log*

# native ios/android generated projects (use EAS/prebuild)
app/ios/
app/android/

# harness / editor
# Claude session scratch stays local, but the agent loop's definitions are
# part of the repo — they are what makes /idea-loop reproducible for anyone
# who clones it.
.claude/*
!.claude/agents/
!.claude/workflows/
!.claude/commands/
.DS_Store
Thumbs.db
.env
.env.local
server/test-state.json

# Native projects are generated by Expo prebuild (CNG) — not source.
app/ios/
app/android/

# agent runtime state (session metadata + transcripts)
belay-agent.json
server/belay-agent.json
tether-agent.json
server/tether-agent.json
agent-logs/
server/agent-logs/

# generated pairing / expo QR pages (contain LAN IP and live code)
*_qr.html
*_qr.png
