<?xml version="1.0" encoding="utf-8"?>
<!--
  BelayVdd.vcxproj — WDK/MSBuild project for the BelayVDD indirect display
  driver. STATUS: WRITTEN-BUT-NOT-COMPILED (authored with no Windows/WDK).
  Requires: Visual Studio 2022 + Windows SDK + WDK (matching versions), with
  the "Windows Driver Kit" VS extension. Build via build-driver.ps1 or:
    msbuild BelayVdd.vcxproj /p:Configuration=Release /p:Platform=x64
  See docs/VIRTUAL-DISPLAY.md for the full build/sign/install runbook.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{c9e2b7d4-5a31-4f8e-b6d0-2e94a1c37f58}</ProjectGuid>
    <RootNamespace>BelayVdd</RootNamespace>
    <ProjectName>BelayVdd</ProjectName>
    <TargetName>BelayVdd</TargetName>
  </PropertyGroup>
  <!--
    WindowsTargetPlatformVersion must be set AFTER Microsoft.Cpp.Default.props:
    $(LatestTargetPlatformVersion) is defined by that import, so referencing it
    in the Globals group above evaluates to empty and the SDK is never resolved.
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <DriverType>UMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>15</UMDF_VERSION_MINOR>
    <!--
      IndirectDisplayDriver is the switch the WDK targets key off to add the
      IddCx include directory and link IddCxStub.lib
      (WindowsDriver.UserMode.CX.LateEvaluation.props / .CX.targets). Without
      it, iddcx.h is not on the include path and the IddCx* symbols do not
      resolve. IDDCX_VERSION_* selects WHICH versioned header and stub get
      used; the WDK default is 1.4, so it must be pinned to 1.2 here to match
      `UmdfExtensions = IddCx0102` in BelayVdd.inf. A driver built against a
      newer IddCx than the INF declares fails to load at runtime.
    -->
    <IndirectDisplayDriver>true</IndirectDisplayDriver>
    <IDDCX_VERSION_MAJOR>1</IDDCX_VERSION_MAJOR>
    <IDDCX_VERSION_MINOR>2</IDDCX_VERSION_MINOR>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!--
      Signing is build-driver.ps1's job, not MSBuild's: the script picks
      between a real PFX (-TestCertPfx) and a throwaway self-signed cert, and
      also has to place that cert in the machine trust stores. Leaving the
      in-build SignTask enabled makes it fail with "No file digest algorithm
      specified" and would in any case sign with whatever cert MSBuild guessed.
    -->
    <SignMode>Off</SignMode>
    <EnableInf2cat>true</EnableInf2cat>
    <Inf2CatWindowsVersionList Condition="'$(Platform)' == 'x64'">10_x64;Server10_x64</Inf2CatWindowsVersionList>
    <Inf2CatWindowsVersionList Condition="'$(Platform)' == 'ARM64'">10_ARM64</Inf2CatWindowsVersionList>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_UNICODE;UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <!-- IddCxStub.lib is added by the WDK targets from IDDCX_LIB_PATH; there
           is no "IddCx.lib" in the WDK at all, so naming it here just fails
           the link. -->
      <AdditionalDependencies>dxgi.lib;d3d11.lib;avrt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="BelayVddIoctl.h" />
    <ClCompile Include="Driver.cpp" />
    <Inf Include="BelayVdd.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    The WDK's DriverPackageTarget copies @(FilesToPackage) into the package
    folder, but nothing in the WDK targets ever adds the project's own binary
    to that item - a driver project is expected to declare it. Without this the
    package folder contains only BelayVdd.inf and Inf2Cat fails signability
    with "belayvdd.dll ... is missing or cannot be decompressed from source
    media". Declared in a target rather than a top-level ItemGroup so
    $(TargetPath) is fully resolved by the time it is evaluated.
  -->
  <Target Name="BelayVddAddBinaryToPackage" BeforeTargets="GetPackageFiles;DriverPackageTarget">
    <ItemGroup>
      <FilesToPackage Include="$(TargetPath)" />
    </ItemGroup>
  </Target>
</Project>
