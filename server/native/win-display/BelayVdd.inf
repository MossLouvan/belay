; BelayVdd.inf — install package for the BelayVDD indirect display driver.
;
; STATUS: WRITTEN-BUT-NOT-COMPILED / NOT INSTALLED. Validate with
;   infverif.exe /v /w BelayVdd.inf   (ships with the WDK)
; and follow docs/VIRTUAL-DISPLAY.md before first install.
;
; Identity is Belay's own: HWID Root\BelayVDD, our class GUID usage per the
; standard Display class, our provider string. Nothing collides with the
; Microsoft sample (Root\IddSampleDriver), SudoVDA, or VirtualDrivers VDD.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = BelayVdd.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

; TargetOSVersion decoration (.10.0...17763) is REQUIRED, not cosmetic:
; this package copies to DIRID 13 (the Driver Store), which infverif rejects
; on an undecorated models section because such a section would also offer
; itself to OS versions that predate DIRID 13 support (10.0.16299 for
; CopyFiles, 10.0.17134 for UMDF). 17763 (Windows 10 1809) is the floor that
; covers both and is also where IddCx 1.2 - the extension this driver pins in
; BelayVdd_UmdfInstall - first shipped.
[Manufacturer]
%ProviderName% = BelayVdd, NTamd64.10.0...17763, NTarm64.10.0...17763

[BelayVdd.NTamd64.10.0...17763]
%DeviceName% = BelayVdd_Install, Root\BelayVDD

[BelayVdd.NTarm64.10.0...17763]
%DeviceName% = BelayVdd_Install, Root\BelayVDD

[SourceDisksFiles]
BelayVdd.dll = 1

[SourceDisksNames]
1 = %DiskName%

; ========== UMDF2 + IddCx wiring ==========

[BelayVdd_Install.NT]
CopyFiles = UMDriverCopy

; Include/Needs WUDFRD.inf rather than hand-rolling the reflector wiring. That
; section installs the device-level registry settings WUDFRd needs in order to
; forward user-mode I/O to the UMDF driver. Without them the device still
; enumerates and the driver still loads, but every DeviceIoControl on it is
; rejected with ERROR_NOT_SUPPORTED before reaching EvtIoDeviceControl — which
; is exactly what a hand-written AddService produced here.
[BelayVdd_Install.NT.hw]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.HW
AddReg  = BelayVdd_HwAddReg

; IndirectKmd is IddCx's kernel-mode companion and must sit above the UMDF
; stack; AllowKernelModeClients below exists solely for it.
[BelayVdd_HwAddReg]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
; Device ACL: SYSTEM and Administrators only, protected from inheritance.
; This is where BelayVDD's control-surface hardening actually lives. UMDF2
; drivers cannot assign their own SDDL from code (WdfDeviceInitAssignSDDLString
; is KMDF-only), so the PnP manager applies it from here instead, before the
; device can be opened. Keep in sync with the note at the top of Driver.cpp.
HKR,, "Security",, "D:P(A;;GA;;;SY)(A;;GA;;;BA)"

; A root-enumerated UMDF2 device still needs a kernel-mode reflector as its
; function driver: WUDFRd. A null service (AddService=,0x2) leaves the devnode
; with no function driver, so the UMDF host is never started and the device
; comes up yellow-banged. This is the pattern the IddCx sample uses.
[BelayVdd_Install.NT.Services]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.Services

[BelayVdd_Install.NT.Wdf]
UmdfService      = BelayVdd, BelayVdd_UmdfInstall
UmdfServiceOrder = BelayVdd
; IddCx's kernel-mode companion (IndirectKmd, the UpperFilter above) is a
; kernel-mode client of this UMDF driver, and it opens the device with a null
; file object — both policies below are required for IddCx to talk to us.
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy     = CannotUseFsContexts
UmdfHostProcessSharing = ProcessSharingDisabled

[BelayVdd_UmdfInstall]
UmdfLibraryVersion = 2.15.0
ServiceBinary      = %13%\BelayVdd.dll
UmdfExtensions     = IddCx0102

[DestinationDirs]
UMDriverCopy = 13 ; Driver Store

[UMDriverCopy]
BelayVdd.dll

[Strings]
ProviderName = "Belay"
DeviceName   = "Belay Virtual Display Adapter"
DiskName     = "Belay Virtual Display Driver Installation Disk"

REG_MULTI_SZ = 0x00010000
